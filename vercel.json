{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/**/*.py": {
      "includeFiles": "{app.py,data/**}",
      "excludeFiles": "{tests/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?__path=/api/:path*"
    }
  ]
}
